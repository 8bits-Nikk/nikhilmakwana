# Contact API configuration.
# Copy to `server/.env` (gitignored) and fill in. Never commit real credentials.

# --- SMTP -------------------------------------------------------------------
# Gmail requires an App Password, not your account password:
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Force implicit TLS. Optional — port 465 turns this on automatically.
SMTP_SECURE=false

# --- Addresses --------------------------------------------------------------
# Display name on outgoing mail: "Nikhil Makwana" <FROM_EMAIL>
APP_NAME=Nikhil Makwana
# Envelope sender. Many providers reject a FROM that is not the authenticated
# mailbox, so keep this equal to SMTP_USER unless you know otherwise.
FROM_EMAIL=
# Where contact messages are delivered. Defaults to FROM_EMAIL when unset.
CONTACT_RECEIVER=

# --- Behaviour --------------------------------------------------------------
PORT=3000
# Log messages instead of sending them. Useful for local development.
MAIL_DRY_RUN=false
# Only needed when the frontend runs on a different origin than the API.
# In production nginx proxies /api, so leave this empty.
# CORS_ORIGIN=http://localhost:5173

# --- Auto-reply to visitors ------------------------------------------------
# A confirmation is emailed to the visitor after their enquiry is delivered.
# Set to false to switch it off.
AUTO_REPLY_ENABLED=true
# Signature lines on the auto-reply (APP_NAME is used as the name).
SIGNATURE_TITLE=Senior Software Engineer
SITE_URL=https://nikhilmakwana.in
